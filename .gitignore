# =============================================================================
# Fitness-AI — .gitignore
# =============================================================================

# --- Secrets & credentials (NEVER commit) --------------------------------
# Firebase service account key
serviceAccountKey.json
**/serviceAccountKey.json
# Firebase web config snippet (contains apiKey/appId)
appconfig.json
# Env files (keep *.example / *.local.example templates)
.env
.env.*
!.env.example
!.env.local.example
!**/.env.example
!**/.env.local.example
# Generic secret stores
secrets/
*.pem
*.key

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.venv/
venv/
env/
.Python
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
coverage.xml
htmlcov/

# Local app data / prototype artifacts
*.db
*.sqlite3
src/users.db
src/users.json

# --- Node / Next.js (frontend/) ------------------------------------------
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Editors & OS --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# --- Logs & temp ---------------------------------------------------------
*.log
logs/
tmp/
*.tmp

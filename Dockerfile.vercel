# syntax=docker/dockerfile:1

# ===========================================================================
# Zesayro — SINGLE container running BOTH the Next.js frontend and the
# FastAPI backend. Python deps are installed with pip from requirements.txt.
# Build from the REPOSITORY ROOT:
#
#   docker build -f Dockerfile.vercel -t zesayro .
#
# The public NEXT_PUBLIC_FIREBASE_* web config has sensible defaults baked in
# below (safe — it ships in the browser bundle anyway). Override any of them
# with --build-arg if you point at a different Firebase project.
#
# Secrets are NEVER baked into the image. GROQ_API_KEY, FIREBASE_PRIVATE_KEY,
# FIREBASE_CLIENT_EMAIL and FIREBASE_PROJECT_ID are supplied at RUN time via
# the host's environment variables (e.g. Vercel project env vars).
# ===========================================================================

# ---- Stage 1: build the Next.js frontend --------------------------------
FROM node:22-bookworm-slim AS frontend
WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Public Firebase web config — inlined into the client bundle at build time.
# These are NOT secrets (they ship in the browser bundle either way), so they
# carry real defaults here and can still be overridden with --build-arg.
# Secrets (GROQ_API_KEY, FIREBASE_PRIVATE_KEY, FIREBASE_CLIENT_EMAIL, ...) are
# NEVER baked in — they are provided at RUN time via Vercel env vars.
# The API base URL is left empty so the browser uses same-origin "/api/..."
# which Next.js proxies to the in-container backend.
ARG NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyB8M6Ff2KxjNY9nyH0Ch7QELeZPBBs0VgY"
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="fitness-ai-project-2f54f.firebaseapp.com"
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID="fitness-ai-project-2f54f"
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="fitness-ai-project-2f54f.firebasestorage.app"
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="945360888886"
ARG NEXT_PUBLIC_FIREBASE_APP_ID="1:945360888886:web:b4c7878ef63183ed372497"
ARG NEXT_PUBLIC_API_BASE_URL=""
ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID \
    NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET \
    NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID \
    NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN npm run build

# ---- Stage 2: final runtime (Python 3.14 + Node.js) ---------------------
FROM python:3.14-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PORT=3000 \
    BACKEND_PORT=8000 \
    BACKEND_INTERNAL_URL=http://127.0.0.1:8000

WORKDIR /app

# Node.js runtime so the frontend can run with `next start`.
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Python deps via pip into an isolated virtualenv (on PATH above). Installing
# into a venv — rather than the system interpreter as root — avoids the pip
# "running as root" warning and keeps the runtime cleanly isolated.
RUN python -m venv "$VIRTUAL_ENV"
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

# Backend + shared AI engine.
COPY src ./src
COPY backend ./backend
COPY main.py ./

# Built frontend (served with `next start`).
COPY --from=frontend /app/frontend ./frontend

COPY docker-entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

# Only the frontend port is exposed; the backend stays internal.
EXPOSE 3000

CMD ["entrypoint"]

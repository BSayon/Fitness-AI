# syntax=docker/dockerfile:1

# ===========================================================================
# Zesayro — SINGLE container running BOTH the Next.js frontend and the
# FastAPI backend. Build from the REPOSITORY ROOT:
#
#   docker build -f Dockerfile.vercel -t zesayro `
#     --build-arg NEXT_PUBLIC_FIREBASE_API_KEY=... `
#     --build-arg NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=... `
#     --build-arg NEXT_PUBLIC_FIREBASE_PROJECT_ID=... `
#     --build-arg NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=... `
#     --build-arg NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=... `
#     --build-arg NEXT_PUBLIC_FIREBASE_APP_ID=... .
#
# The NEXT_PUBLIC_* Firebase values are inlined into the browser bundle at
# BUILD time, so they must be passed as --build-arg. Backend secrets
# (GROQ_API_KEY, FIREBASE_PROJECT_ID/CLIENT_EMAIL/PRIVATE_KEY, ...) are passed
# at RUN time via --env-file .env or -e flags.
# ===========================================================================

# ---- Stage 1: build the Next.js frontend --------------------------------
FROM node:22-bookworm-slim AS frontend
WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Public Firebase web config — inlined into the client bundle at build time.
# The API base URL is left empty so the browser uses same-origin "/api/..."
# which Next.js proxies to the in-container backend.
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ARG NEXT_PUBLIC_API_BASE_URL=""
ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID \
    NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET \
    NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID \
    NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN npm run build

# ---- Stage 2: uv binary --------------------------------------------------
FROM ghcr.io/astral-sh/uv:latest AS uv

# ---- Stage 3: final runtime (Node + uv-managed Python 3.14) -------------
FROM node:22-bookworm-slim

COPY --from=uv /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    UV_NO_PROGRESS=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PORT=3000 \
    BACKEND_PORT=8000 \
    BACKEND_INTERNAL_URL=http://127.0.0.1:8000

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Python deps (uv fetches a managed CPython 3.14 as required by pyproject.toml).
COPY pyproject.toml uv.lock ./
RUN uv python install 3.14 \
    && uv sync --frozen --no-dev --no-install-project

# Backend + shared AI engine.
COPY src ./src
COPY backend ./backend
COPY main.py ./

# Built frontend (served with `next start`).
COPY --from=frontend /app/frontend ./frontend

COPY docker-entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

# Only the frontend port is exposed; the backend stays internal.
EXPOSE 3000

CMD ["entrypoint"]
